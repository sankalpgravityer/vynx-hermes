# ============================================================
# Copy this file to .env  (no extension, no .txt)
# ============================================================

# --- Gemini -----------------------------------------------------------------
# Leave HERMES_LLM_ENABLED=false for your first local run. Hermes will run the
# rule engine only, needs no API key, and costs nothing. Turn it on once the
# deterministic layer looks right to you.
HERMES_LLM_ENABLED=false
GEMINI_API_KEY=

# --- VNYX write-back --------------------------------------------------------
# Not needed while you POST product payloads directly from Postman, nor for
# /v1/review-queue (vnyx-api calls that one and sends everything in the body).
# Only required for /v1/reconcile and /v1/batch, which fetch and write by id.
#
# The API is its own host with NO path prefix — routes are /products, /categories,
# /sizes, /brands. dev.vnyx.ai is the frontend; api-dev.vnyx.ai is the API.
VNYX_BASE_URL=https://api-dev.vnyx.ai
VNYX_API_TOKEN=
VNYX_TIMEOUT_S=20

# --- Safety -----------------------------------------------------------------
# true = compute and log patches, write nothing back to VNYX. Keep it here.
HERMES_DRY_RUN=true

# Leave unset to default to ./logs/audit.jsonl next to the project.
# HERMES_AUDIT_PATH=
# HERMES_WEBHOOK_SECRET=
# HERMES_POLICY=

# --- Nous Research Hermes AGENT (a different Hermes) ------------------------
# Powers POST /v1/agent/prompt, which relays a prompt to the `hermes` CLI from
# github.com/NousResearch/hermes-agent. Nothing to do with the verification
# rules above — that agent is an autonomous LLM, this service decides nothing
# with a model.
#
# OFF BY DEFAULT, and leave it off unless you want it. The agent has terminal
# and filesystem tools on this host, so anyone who can reach the endpoint can
# effectively run commands here. This service has no auth of its own, so only
# enable it while the port is bound to localhost.
HERMES_AGENT_ENABLED=false

# Full path to the `hermes` executable. Normally NOT needed — the adapter knows
# the installer's layout and finds it without PATH, which matters because a
# service started before the installer ran keeps the old PATH.
#
# The real location is one level deeper than HERMES_HOME:
#   binary : %LOCALAPPDATA%\hermes\hermes-agent\bin\hermes.exe
#   config : %LOCALAPPDATA%\hermes\.env  and  config.yaml
# Set this only for an install somewhere else.
# HERMES_AGENT_BIN=C:\Users\you\AppData\Local\hermes\hermes-agent\bin\hermes.exe

# Seconds before a run is killed (its whole process tree). Capped at 900.
HERMES_AGENT_TIMEOUT_S=300

# Concurrent agent runs. Each holds a model connection and a shell, so keep it
# small; further requests queue rather than pile up.
HERMES_AGENT_MAX_CONCURRENT=2
