# ============================================================
# Copy this file to .env  (no extension, no .txt)
# ============================================================

# --- Gemini -----------------------------------------------------------------
# Leave HERMES_LLM_ENABLED=false for your first local run. Hermes will run the
# rule engine only, needs no API key, and costs nothing. Turn it on once the
# deterministic layer looks right to you.
HERMES_LLM_ENABLED=false
GEMINI_API_KEY=

# --- VNYX write-back --------------------------------------------------------
# Not needed while you POST product payloads directly from Postman, nor for
# /v1/review-queue (vnyx-api calls that one and sends everything in the body).
# Only required for /v1/reconcile and /v1/batch, which fetch and write by id.
#
# The API is its own host with NO path prefix — routes are /products, /categories,
# /sizes, /brands. dev.vnyx.ai is the frontend; api-dev.vnyx.ai is the API.
VNYX_BASE_URL=https://api-dev.vnyx.ai
VNYX_API_TOKEN=
VNYX_TIMEOUT_S=20

# --- Safety -----------------------------------------------------------------
# true = compute and log patches, write nothing back to VNYX. Keep it here.
HERMES_DRY_RUN=true

# Leave unset to default to ./logs/audit.jsonl next to the project.
# HERMES_AUDIT_PATH=
# HERMES_WEBHOOK_SECRET=
# HERMES_POLICY=
