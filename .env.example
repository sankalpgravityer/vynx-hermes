# ============================================================
# Copy this file to .env  (no extension, no .txt)
# ============================================================

# --- Gemini -----------------------------------------------------------------
# Leave HERMES_LLM_ENABLED=false for your first local run. Hermes will run the
# rule engine only, needs no API key, and costs nothing. Turn it on once the
# deterministic layer looks right to you.
HERMES_LLM_ENABLED=false
GEMINI_API_KEY=

# --- Image generation -------------------------------------------------------
# The ONLY key used to GENERATE on-model images. GEMINI_API_KEY above is for the
# text and vision evidence layer and is never used for generation.
#
# Separate because the two have separate quotas and separate costs: a rules-only
# deployment needs no image key at all, and exhausting the image quota must not
# take the evidence layer down with it. vnyx-api draws the same line.
#
# COMMA-SEPARATED for more than one key, rotated round-robin — four views
# generate concurrently and each retry adds a call, so one key meets its
# per-minute limit quickly.
#   GOOGLE_NANO_BANANA_API_KEY=AIza...one,AIza...two
#
# Unset means /v1/imagery/generate answers 503; verification is unaffected.
GOOGLE_NANO_BANANA_API_KEY=

# --- VNYX write-back --------------------------------------------------------
# Not needed while you POST product payloads directly from Postman, nor for
# /v1/review-queue (vnyx-api calls that one and sends everything in the body).
# Only required for /v1/reconcile and /v1/batch, which fetch and write by id.
#
# The API is its own host with NO path prefix — routes are /products, /categories,
# /sizes, /brands. dev.vnyx.ai is the frontend; api-dev.vnyx.ai is the API.
VNYX_BASE_URL=https://api-dev.vnyx.ai
VNYX_API_TOKEN=
VNYX_TIMEOUT_S=20

# --- Safety -----------------------------------------------------------------
# true = compute and log patches, write nothing back to VNYX. Keep it here.
HERMES_DRY_RUN=true

# Leave unset to default to ./logs/audit.jsonl next to the project.
# HERMES_AUDIT_PATH=
# HERMES_WEBHOOK_SECRET=
# HERMES_POLICY=

# --- Imagery ----------------------------------------------------------------
# Force image downloads onto IPv4.
#
# Turn this on if /v1/imagery/verify is slow and the logs show a fetch taking
# ~40s for a small file. That is the AAAA record being tried first and timing out
# before the IPv4 fallback — the same reason this project uses 127.0.0.1 rather
# than localhost for service-to-service calls. Measured on the dev host: 43.1s
# with it off, 1.2s with it on, for the same object.
#
# Leave it OFF by default and off in any deployment with working IPv6 — binding
# to 0.0.0.0 makes an IPv6-only network unreachable.
HERMES_IMAGE_FETCH_IPV4=false

# --- Nous Research Hermes AGENT (a different Hermes) ------------------------
# Powers POST /v1/agent/prompt, which relays a prompt to the `hermes` CLI from
# github.com/NousResearch/hermes-agent. Nothing to do with the verification
# rules above — that agent is an autonomous LLM, this service decides nothing
# with a model.
#
# OFF BY DEFAULT, and leave it off unless you want it. The agent has terminal
# and filesystem tools on this host, so anyone who can reach the endpoint can
# effectively run commands here. This service has no auth of its own, so only
# enable it while the port is bound to localhost.
HERMES_AGENT_ENABLED=false

# Full path to the `hermes` executable. Normally NOT needed — the adapter knows
# the installer's layout and finds it without PATH, which matters because a
# service started before the installer ran keeps the old PATH.
#
# The real location is one level deeper than HERMES_HOME:
#   binary : %LOCALAPPDATA%\hermes\hermes-agent\bin\hermes.exe
#   config : %LOCALAPPDATA%\hermes\.env  and  config.yaml
# Set this only for an install somewhere else.
# HERMES_AGENT_BIN=C:\Users\you\AppData\Local\hermes\hermes-agent\bin\hermes.exe

# Seconds before a run is killed (its whole process tree). Capped at 900.
HERMES_AGENT_TIMEOUT_S=300

# Concurrent agent runs. Each holds a model connection and a shell, so keep it
# small; further requests queue rather than pile up.
HERMES_AGENT_MAX_CONCURRENT=2

# --- OpenAI image fallback --------------------------------------------------
# The LAST step of the generation chain, and only reached when every configured
# Gemini image model has produced nothing for a view.
#
# Gemini blocks a garment whose print names or shows a real person — a band tee,
# a film shirt, `RODGERS 12` on a jersey — and it blocks the REQUEST, not the
# response: prompt_feedback.block_reason with zero candidates, back in under four
# seconds where a real render takes twenty-five. A classifier reads the request
# before the generation model does, so no prompt wording changes the outcome and
# every Gemini model gives the same answer.
#
# gpt-image-1 renders those garments correctly. Leave this unset to disable the
# fallback entirely — generation then simply reports the view as unproducible.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
