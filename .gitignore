# ── Secrets ─────────────────────────────────────────────────────────────────
# .env holds a real GEMINI_API_KEY and (once set) a VNYX_API_TOKEN. Never
# commit it — .env.example documents every variable instead.
.env
.env.*
!.env.example

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtualenvs — 71MB here, and machine-specific. Recreate with
# `pip install -r requirements.txt`.
.venv/
venv/
env/
ENV/

# ── Test / tooling caches ───────────────────────────────────────────────────
# app/llm/cache.py's file backend: one JSON answer per image the vision model
# has already judged. Rebuilds itself; never worth committing.
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ── Runtime output ──────────────────────────────────────────────────────────
# audit.jsonl records every product Hermes has judged, so it is real tenant
# data and grows without bound. The directory is kept (the service writes into
# it) but its contents are not tracked.
logs/*
!logs/.gitignore

# The spreadsheets scripts/fix_review_prices.py produces. Each one is a list of
# real product ids and prices for a tenant, so it is customer data, not output
# worth keeping in the repo.
reports/

# ── Editors / OS ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
